# === Application ===
APP_NAME=KSP Crime Intelligence Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# === Security ===
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ksp_user
POSTGRES_PASSWORD=ksp_secure_pass_2025
POSTGRES_DB=ksp_crime_intel
DATABASE_URL=postgresql+asyncpg://ksp_user:ksp_secure_pass_2025@localhost:5432/ksp_crime_intel

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ksp_neo4j_2025

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === ChromaDB ===
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# === Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=4096

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
